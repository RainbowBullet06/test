{
  "name": "evaluaciones-comunicacion",
  "productName": "Evaluaciones de Comunicación",
  "version": "1.0.0",
  "description": "Sistema de apoyo para evaluaciones de comunicación verbal (USAER / CAM)",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "electron": "npm run build && electron .",
    "electron:dev": "electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "mx.educacionespecial.evaluaciones",
    "productName": "Evaluaciones de Comunicación",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "docxtemplater": "^3.71.0",
    "framer-motion": "^13.4.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.47.0",
    "pizzip": "^3.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
